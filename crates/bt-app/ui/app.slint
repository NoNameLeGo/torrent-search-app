// bt-app —— 应用界面。唯一的 UI，对齐 docs/ROADMAP.md §2.2 与设计稿
// 「BT 聚合搜索 · Rust 界面重设计」（Ardot file 740017630029174）。
//
// ⚠️ 这里只用 M1 spike 已经**实测过**的元素：std-widgets 的 LineEdit / Button / ListView，
// 加上内置的 Text / Rectangle / 布局。刻意不用 ComboBox / ScrollView 之类没在本机验证过的
// 控件 —— 本机没有编译器，Slint API 写错的代价是一轮 CI。
//
// ⚠️ 四条硬约束（踩过或差点踩）：
//   1. 富文本属性类型必须是 `styled-text`（不是 `string`）—— 高亮是 Rust 侧
//      `StyledText::from_markdown()` 构造的 markup，`@markdown()` 会把插值整体转义。
//   2. **别在 `init` 里写全局属性** —— 会形成属性依赖环（实测 200 条数据触发 2628 次实例化）。
//   3. std-widgets 的 `Button` **没有 `color`** —— 颜色只能落在 `Text` / `Rectangle` 上。
//      所以按钮是自绘的 `AppButton`（Rectangle + Text + TouchArea）。`TouchArea` 是本文件里
//      唯一没在 M1 探针中出现过的元素，只用来收点击、不参与排版。
//   4. `Theme.hl` 是 Rust 侧关键词高亮的**唯一来源**（main.rs `accent_hex`）；改名即静默变色。
//      同理 `ok` / `err` / `sub` 由 `tone_color` 读取，不能删。

// ⚠️ 这个 import 是**显式列名**的 —— 用任何 std-widgets 组件都必须在这里列出来，
// 否则报 `Unknown element 'X'`（2026-10-28：加 TextEdit 忘了加进这行，CI 直接红）。
import { LineEdit, ListView, TextEdit } from "std-widgets.slint";

// 一条搜索结果 —— 字段全部由 Rust 侧 src/ui_model.rs 产出（那一层是纯函数、有单测）。
export struct ResultRow {
    // 行号。`push-row(int)` 用它回指 Rust 的权威 Vec（UI 模型可能整体重建，行号必须稳）
    idx: int,
    // 是否被勾选（批量推送 / 导出）。**由 Rust 侧的 key 集合算出**，UI 不自己存。
    selected: bool,
    // 标题：styled-text + Rust 侧构造的 markup（关键词高亮）
    title-markup: styled-text,
    // 同一标题的纯文本版本（不做高亮时/无障碍用）
    title-plain: string,
    meta: string,
    provider: string,
    seeds: int,
    leechers: int,
    // 按钮文案由 Rust 决定："取磁力并推送" / "推送到下载器" / "解析中…"
    action-label: string,
}

// 一条在线影视搜索结果（Video 模式）。字段由 Rust 侧 `video` 模块 + 映射层产出。
export struct VideoRow {
    idx: int,
    title: string,
    meta: string,
    provider: string,
}

// 一条网盘搜索结果（Pan 模式）。点击打开网盘链接并复制提取码。
export struct PanRow {
    idx: int,
    title: string,
    meta: string,
    provider: string,
}

// 每站状态 —— 形状对齐 `bt_providers::ProviderStatus`（`ok` / `error` / `pending`）。
// ⚠️ 字形与颜色都由 **Rust 侧算好**（ui_model.rs），.slint 里不写三元表达式。
export struct ProviderChip {
    id: string,
    name: string,
    glyph: string,
    detail: string,
    tone: color,
}

// 站点开关的一行（③ 用户级站点选择）。文案与颜色同样由 Rust 算好。
export struct SiteToggle {
    id: string,
    label: string,
    tone: color,
}

// 排序键 / 分类 chip。文案（含方向箭头与"选中"标记）由 Rust 侧算好。
export struct Chip {
    id: string,
    label: string,
}

// ⑤ 一行索引器（Torznab）。文案全由 Rust 算好（含 ✓/✗ 与"停用/启用"）。
// `id` 是身份（用 URL），不要用下标。
export struct IndexerRow {
    id: string,
    label: string,
    action: string,
}

// 详情面板（屏 03）用**扁平属性**而不是 struct：struct 性质的 property 需要初值，
// 而 `styled-text` 的初值写法没在本机验证过 —— 本机没编译器，不值得赌。
// 数据全部来自 `ui_model::RowData` 里已有的原始字段（magnet / info_hash / detail_url）。

// Catppuccin Mocha —— 只用官方 token，不自己造中间色。
// 语义分工（设计稿定稿）：mauve = 操作/选中，peach = 命中词，green = 做种，
// blue = 来源链接，maroon = 低做种，red = 失败/超时。
export global Theme {
    out property <color> crust:    #11111b;
    out property <color> mantle:   #181825;
    out property <color> base:     #1e1e2e;
    out property <color> surface0: #313244;
    out property <color> surface1: #45475a;
    out property <color> dim:      #585b70;
    out property <color> sub:      #7f849c;
    out property <color> subtext:  #a6adc8;
    out property <color> text:     #cdd6f4;
    out property <color> mauve:    #cba6f7;
    out property <color> peach:    #fab387;
    out property <color> green:    #a6e3a1;
    out property <color> blue:     #89b4fa;
    out property <color> maroon:   #eba0ac;
    out property <color> yellow:   #f9e2af;
    out property <color> ok:       #a6e3a1;
    out property <color> err:      #f38ba8;
    // ⚠️ Rust 侧读取的三个名字：hl（高亮）/ accent（链接）/ bg·card（旧布局用）
    // hl 按设计稿定稿是 **yellow**（关键词高亮），peach 已经不是高亮色 ——
    // 主操作色是 mauve，peach 与 yellow 同属暖色会抢焦点。改值即生效
    // （main.rs 的 accent_hex 只读这个名字）。
    out property <color> hl:       #f9e2af;
    out property <color> accent:   #89b4fa;
    out property <color> bg:       #11111b;
    out property <color> card:     #181825;
}

// 自绘按钮。std-widgets 的 `Button` **没有 `color`**（老坑，见文件头），
// 而设计稿要紫底 CTA ⇒ 只能用 Rectangle + Text + TouchArea 拼一个。
// ⚠️ 不用 `enabled`：那是内建属性名；这里用 `active` 同时管配色与点击。
// ⚠️ 位置必须**在第一个使用它的组件之前** —— Slint 按声明顺序解析，放后面会报
// `Unknown element 'AppButton'`（2026-10-25 CI 40174701768 就栽在这）。
component AppButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> active: true;
    in property <length> text-size: 12px;
    callback clicked;

    height: 30px;
    // 默认宽度**按文字自适应**（屏 01 的分类/排序 chips 是横排的，需要它）。
    // 显式 `width:` 仍然覆盖这条（现有调用大多显式给了宽度，行为不变）。
    // ⚠️ 用 `txt.preferred-width` 不会成环：Text 的 preferred-width 只取决于
    // 文字与字体，与它自己的 `width: parent.width` 无关。
    width: txt.preferred-width + 24px;
    border-radius: 6px;
    border-width: 1px;
    background: !root.active ? Theme.surface0 : (root.primary ? Theme.mauve : Theme.surface1);
    border-color: !root.active ? Theme.surface0 : (root.primary ? Theme.mauve : Theme.surface0);
    // hover 只降一点不透明度（Mocha 没有官方 hover 色，不自己造中间色）
    opacity: ta.has-hover && root.active ? 0.86 : 1.0;

    // TouchArea 放最前：它只收事件，不挡视觉；Text 叠在上面。
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if (root.active) {
                root.clicked();
            }
        }
    }

    txt := Text {
        text: root.label;
        font-size: root.text-size;
        color: !root.active ? Theme.dim : (root.primary ? Theme.crust : Theme.subtext);
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// 一条结果行。
// ⚠️ 必须**转发** push：组件里的 `root` 指的是这个组件实例，不是窗口。
component ResultCard inherits Rectangle {
    in property <ResultRow> item;
    callback push(int);
    // 打开详情面板（屏 03）。同样要转发。
    callback open(int);
    // 勾选 / 取消勾选一行（批量操作用）
    callback toggle(int);

    height: 88px;
    background: transparent;

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 0px;

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 12px;

            // 勾选：实心块 = 选中（不用字形/图标，少一处排版风险）。
            // 外面套一层 VerticalLayout 只为了**纵向居中** —— Rectangle 没有
            // `vertical-alignment`（Text 才有），这是文件里已有的做法。
            VerticalLayout {
                width: 16px;
                alignment: center;

                Rectangle {
                    width: 16px;
                    height: 16px;
                    border-radius: 4px;
                    background: item.selected ? Theme.mauve : #00000000;
                    border-width: 1px;
                    border-color: item.selected ? Theme.mauve : Theme.surface1;

                    TouchArea {
                        clicked => { root.toggle(item.idx); }
                    }
                }
            }

            // 做种数：整行的视觉锚点（设计稿的「海报数字」）
            Text {
                text: "\{item.seeds}";
                width: 64px;
                font-size: 20px;
                font-weight: 700;
                color: Theme.green;
                vertical-alignment: center;
            }

            // 标题（富文本 + 自动换行）+ 元信息
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 4px;

                StyledText {
                    text: item.title-markup;
                    default-color: Theme.text;
                    default-font-size: 14px;
                    // 两条以内，超了省略 —— 中文标题 + 高亮 + 换行正是 M1 压过的组合
                    max-lines: 2;
                }

                Text {
                    text: item.meta;
                    color: Theme.sub;
                    font-size: 11px;
                }
            }

            // 来源站
            Text {
                text: item.provider;
                width: 96px;
                font-size: 11px;
                color: Theme.accent;
                vertical-alignment: center;
            }

            // 动作（Rust 决定文案：取磁力/推送/解析中）+ 详情
            HorizontalLayout {
                spacing: 6px;

                AppButton {
                    label: "详情";
                    width: 64px;
                    height: 30px;
                    text-size: 11px;
                    clicked => { root.open(item.idx); }
                }

                AppButton {
                    label: item.action-label;
                    width: 112px;
                    height: 30px;
                    text-size: 11px;
                    primary: true;
                    clicked => { root.push(item.idx); }
                }
            }
        }

        // 行分隔线
        Rectangle {
            height: 1px;
            background: Theme.surface1;
        }
    }
}

// 一条在线影视结果（Video 模式）。没有勾选/推送 —— 只有「打开网页」。
component VideoCard inherits Rectangle {
    in property <VideoRow> item;
    callback open(int);

    height: 76px;
    background: transparent;

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 0px;

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 12px;

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 4px;

                Text {
                    text: item.title;
                    color: Theme.text;
                    font-size: 14px;
                    wrap: word-wrap;
                }

                Text {
                    text: item.meta;
                    color: Theme.sub;
                    font-size: 11px;
                }
            }

            Text {
                text: item.provider;
                width: 96px;
                font-size: 11px;
                color: Theme.accent;
                vertical-alignment: center;
            }

            AppButton {
                label: "打开网页";
                width: 96px;
                height: 30px;
                text-size: 11px;
                primary: true;
                clicked => { root.open(item.idx); }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.surface1;
        }
    }
}

// 一条网盘结果（Pan 模式）：没有勾选/推送 —— 打开链接 + 复制提取码。
component PanCard inherits Rectangle {
    in property <PanRow> item;
    callback open(int);

    height: 76px;
    background: transparent;

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 0px;

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 12px;

            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 4px;

                Text {
                    text: item.title;
                    color: Theme.text;
                    font-size: 14px;
                    wrap: word-wrap;
                }

                Text {
                    text: item.meta;
                    color: Theme.sub;
                    font-size: 11px;
                }
            }

            Text {
                text: item.provider;
                width: 96px;
                font-size: 11px;
                color: Theme.accent;
                vertical-alignment: center;
            }

            AppButton {
                label: "打开 / 复制";
                width: 104px;
                height: 30px;
                text-size: 11px;
                primary: true;
                clicked => { root.open(item.idx); }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.surface1;
        }
    }
}

// 一站状态的小条。
component ProviderRow inherits Rectangle {
    in property <ProviderChip> item;

    height: 20px;
    background: transparent;

    HorizontalLayout {
        spacing: 6px;
        Text {
            text: item.glyph;
            color: item.tone;
            font-size: 10px;
            vertical-alignment: center;
        }
        Text {
            text: item.name;
            color: Theme.text;
            font-size: 11px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: item.detail;
            color: Theme.dim;
            font-size: 10px;
            vertical-alignment: center;
        }
    }
}

// 一个站点开关。`Button` 没有 `color`，所以颜色在 Text 上、按钮单独放右边。
component SiteRow inherits Rectangle {
    in property <SiteToggle> item;
    callback toggle(string);

    height: 22px;
    background: transparent;

    HorizontalLayout {
        spacing: 6px;

        Text {
            text: item.label;
            color: item.tone;
            font-size: 11px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        AppButton {
            label: "切换";
            width: 48px;
            height: 22px;
            text-size: 10px;
            clicked => { root.toggle(item.id); }
        }
    }
}

// 排序 / 分类 chip。
// ⚠️ `can-pick` 不只是美观：搜索期间重排会让增量 push 的 `skip` 错位（见 main.rs 的注释）。
component ChipRow inherits Rectangle {
    in property <Chip> item;
    in property <bool> can-pick: true;
    callback pick(string);

    height: 26px;
    // 宽度跟着文字走 —— 横排（搜索区下方）需要它；竖排时也左对齐成紧凑 chip。
    width: btn.width;
    background: transparent;

    btn := AppButton {
        label: item.label;
        height: 26px;
        text-size: 11px;
        active: root.can-pick;
        clicked => { root.pick(item.id); }
    }
}

// 右栏的小标题
component RailLabel inherits Text {
    font-size: 10px;
    color: Theme.dim;
    height: 14px;
    vertical-alignment: center;
}

export component AppWindow inherits Window {
    in-out property <string> query: "";
    in-out property <[ResultRow]> rows;
    // Video 模式（在线影视搜索 → 打开网页）。与 BT 的 rows 分开，互不污染。
    in-out property <[VideoRow]> video-rows;
    in-out property <[PanRow]> pan-rows;
    // 0 = 磁力 / 1 = 视频 / 2 = 网盘
    in-out property <int> mode: 0;
    // 视频源数量（Rust 侧从 video::registry() 填，避免空态文案写死）
    in-out property <int> video-sites: 0;
    in-out property <string> pansou-url: "http://127.0.0.1:8888";
    in-out property <string> pansou-token: "";
    in-out property <string> pansou-status: "默认 127.0.0.1:8888";
    // 影视源（TVBox 单仓导入，只取 type=1 的苹果CMS JSON 源）
    in-out property <string> tvbox-url: "";
    // 手写规则（JSON 或 YAML）：粘进来 → 测试 → 保存
    in-out property <string> rule-text: "";
    in-out property <string> rule-status: "未填写规则";
    // 订阅：一个返回源清单的 URL（格式按内容自动判断）
    in-out property <string> sub-url: "";
    in-out property <string> sub-status: "无订阅";
    in-out property <string> tvbox-status: "未导入影视源";
    in-out property <[ProviderChip]> providers;
    in-out property <[SiteToggle]> sites;
    in-out property <[Chip]> sorts;
    in-out property <[Chip]> cats;
    in-out property <bool> searching: false;
    in-out property <string> status-text: "就绪";
    in-out property <string> downloader-kind: "qbittorrent";
    in-out property <string> downloader-url: "";
    in-out property <string> downloader-user: "";
    in-out property <string> downloader-secret: "";
    in-out property <string> downloader-status: "未配置下载器";
    // ---- 屏 01 右栏三卡 ----
    // ⚠️ 所有数字都由 Rust 侧 `sync_small` 算好再灌进来，`.slint` 里不写统计逻辑
    // （同 "文案与颜色由 Rust 算好" 的既有约定）。
    in-out property <string> downloader-name: "未配置";
    in-out property <int> scan-done: 0;
    in-out property <int> scan-total: 0;
    // 进度条用 0.0~1.0；Slint 的 length × float 是合法的
    in-out property <float> scan-progress: 0.0;
    in-out property <string> scan-note: "未开始";
    in-out property <int> stats-hits: 0;
    in-out property <int> stats-dedup: 0;
    in-out property <int> stats-fail: 0;
    in-out property <string> stats-elapsed: "—";
    in-out property <string> indexer-name: "";
    in-out property <string> indexer-url: "";
    in-out property <string> indexer-key: "";
    in-out property <string> indexer-status: "未配置索引器";
    in-out property <[IndexerRow]> indexers;
    // 数据源统一注册表（sources.json）的摘要行。批次 1 只读 —— 列表/开关在批次 2。
    in-out property <string> sources-status: "数据源：未加载";
    in-out property <int> total: 0;
    in-out property <int> page: 1;
    in-out property <bool> has-more: false;
    // 屏 03 详情面板（扁平属性；见 struct 区的注释）。Rust 侧在打开/关闭/新搜索/重排时写。
    in-out property <bool> detail-open: false;
    in-out property <int> detail-idx: -1;
    in-out property <string> detail-title: "";
    in-out property <string> detail-meta: "";
    in-out property <string> detail-provider: "";
    in-out property <int> detail-seeds: 0;
    in-out property <int> detail-leechers: 0;
    in-out property <string> detail-infohash: "";
    in-out property <string> detail-magnet: "";
    in-out property <string> detail-url: "";
    in-out property <string> detail-action: "";
    // 纯 UI 状态：配置区开合。Rust 侧不读它，默认收起 —— 主界面只留搜索与结果。
    in-out property <bool> config-open: false;
    // 批量选择：Rust 侧按 key 集合算出（排序会重编号 idx，不能用 idx 存选择）
    in-out property <int> selected-count: 0;

    callback search(string);
    // 磁力 / 视频 两个 tab 的切换；以及 Video 行的「打开网页」。
    callback switch-mode(int);
    callback open-video(int);
    callback open-pan(int);
    callback save-pansou();
    // PanSou 探活：连不上要说清楚，连上了报「这个实例支持哪些源」
    callback probe-pansou();
    // 影视源：导入一份 TVBox 单仓配置 / 清空已导入的源
    callback import-tvbox();
    // 规则：真跑一次搜索验证 / 存进注册表
    callback test-rule();
    callback save-rule();
    // 订阅：添加（并立刻刷新）/ 刷新全部
    callback add-subscription();
    callback refresh-subs();
    callback clear-tvbox();
    callback push-row(int);
    callback pick-kind(string);
    callback detect-downloader();
    callback save-downloader();
    callback add-indexer();
    callback clear-indexers();
    callback toggle-indexer(string);
    callback next-page();
    callback toggle-site(string);
    callback pick-sort(string);
    callback pick-category(string);
    // 屏 03
    callback open-row(int);
    callback close-detail();
    // 屏 03：拿这一行的片名去某家字幕站搜索（第二参数是 `subs::SubtitleSite.id`）。
    // ⚠️ 只拼 URL 交给浏览器，不内置抓取 —— 见 docs/BACKLOG-ZHUIJU.md §2.1
    callback find-subtitle(int, string);
    // 批量：勾选一行 / 全选 / 清空 / 推送 / 导出
    callback toggle-row(int);
    callback select-all();
    callback clear-selection();
    callback batch-push();
    callback export-csv();
    callback copy-magnet(int);
    callback copy-selected-magnets();

    title: "BT 聚合搜索";
    width: 1280px;
    height: 832px;
    background: Theme.crust;
    // CJK 靠它 + 系统字体回退（spike 实测可行）
    default-font-family: "Microsoft YaHei";
    default-font-size: 13px;

    VerticalLayout {
        spacing: 0px;

        // ---- 顶栏 ----
        Rectangle {
            height: 40px;
            background: Theme.mantle;

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 16px;
                spacing: 10px;

                Rectangle {
                    width: 18px;
                    height: 18px;
                    border-radius: 4px;
                    background: Theme.mauve;
                }

                Text {
                    text: "BT 聚合搜索";
                    font-size: 12px;
                    font-weight: 600;
                    color: Theme.text;
                    vertical-alignment: center;
                }

                Text {
                    text: "RUST";
                    font-size: 9px;
                    color: Theme.dim;
                    vertical-alignment: center;
                }

                // 磁力 / 视频：选中态用 primary（紫底），两个都保持可点。
                AppButton {
                    label: "磁力";
                    width: 56px;
                    height: 26px;
                    text-size: 11px;
                    primary: root.mode == 0;
                    clicked => { root.switch-mode(0); }
                }

                AppButton {
                    label: "视频";
                    width: 56px;
                    height: 26px;
                    text-size: 11px;
                    primary: root.mode == 1;
                    clicked => { root.switch-mode(1); }
                }

                // 网盘模式（mode 2）。⚠️ 2026-10-26 之前**没有这个入口** ——
                // Rust 侧 pan 搜索与 PanCard 都在，UI 上却点不到，等于功能不存在。
                AppButton {
                    label: "网盘";
                    width: 56px;
                    height: 26px;
                    text-size: 11px;
                    primary: root.mode == 2;
                    clicked => { root.switch-mode(2); }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                AppButton {
                    label: root.config-open ? "收起" : "设置";
                    width: 64px;
                    height: 26px;
                    text-size: 11px;
                    clicked => { root.config-open = !root.config-open; }
                }
            }
        }

        // ---- 搜索区 ----
        Rectangle {
            background: Theme.crust;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 8px;

                    LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: root.mode == 1 ? "片名（回车搜索在线影视）" : (root.mode == 2 ? "网盘资源关键词（回车搜索）" : "关键词（回车搜索）");
                        text <=> root.query;
                        accepted(t) => { root.search(t); }
                    }

                    AppButton {
                        label: root.searching ? "搜索中…" : "搜索";
                        width: 88px;
                        height: 34px;
                        primary: true;
                        active: !root.searching;
                        clicked => { root.search(root.query); }
                    }

                    // ① 分页：`has-more` 来自引擎层，不是"这页满了"的猜测
                    // ⚠️ 用 `if` 而不是 `visible:` —— Slint 的 visible 只停止绘制，
                    // **仍然占布局空间**（ogoffart：#4021），会让列表被挤扁。
                    if root.mode == 0 : AppButton {
                        label: "第 \{root.page} 页 · 下一页";
                        width: 124px;
                        height: 34px;
                        active: !root.searching && root.has-more;
                        clicked => { root.next-page(); }
                    }
                }

                // 分类 chips —— 屏 01 的位置：**搜索条下方横排**，不再塞在右栏里
                // （右栏那个 104px 高的 ListView 只装得下 4 个，多的直接看不见）。
                // ⚠️ 用 `for` 直接横排：`ListView` 只支持纵向；外层 Rectangle 加 clip
                // 兜住"分类名特别多"时的溢出，避免画到窗口外面去。
                if root.mode == 0 : Rectangle {
                    height: 26px;
                    clip: true;

                    HorizontalLayout {
                        spacing: 6px;

                        Text {
                            text: "分类";
                            font-size: 10px;
                            color: Theme.dim;
                            width: 26px;
                            vertical-alignment: center;
                        }

                        for c in root.cats : ChipRow {
                            item: c;
                            can-pick: !root.searching;
                            pick(id) => { root.pick-category(id); }
                        }

                        // 弹性占位：分类少的时候把排序推到右边，分类多的时候先挤它
                        Rectangle {
                            horizontal-stretch: 1;
                            min-width: 8px;
                        }

                        Text {
                            text: "排序";
                            font-size: 10px;
                            color: Theme.dim;
                            width: 26px;
                            vertical-alignment: center;
                        }

                        for s in root.sorts : ChipRow {
                            item: s;
                            can-pick: !root.searching;
                            pick(id) => { root.pick-sort(id); }
                        }
                    }
                }

                // ⚠️ 状态行单独一行：它是"一条都没有"时唯一告诉用户该干什么的地方
                Text {
                    text: root.status-text;
                    color: Theme.sub;
                    font-size: 11px;
                }
            }
        }

        // ---- 配置区（默认收起；顶栏「设置」切换）----
        // ⚠️ 必须用 `if`：`visible:` 收起时仍占约 192px 高，把结果列表顶到屏幕下半截。
        if root.config-open : Rectangle {
            background: Theme.mantle;
            border-width: 1px;
            border-color: Theme.surface0;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    spacing: 6px;
                    Text { text: "下载器"; color: Theme.sub; font-size: 11px; vertical-alignment: center; }
                    AppButton { label: "qB";  height: 26px; text-size: 11px; clicked => { root.pick-kind("qbittorrent"); } }
                    AppButton { label: "TR";  height: 26px; text-size: 11px; clicked => { root.pick-kind("transmission"); } }
                    AppButton { label: "aria2"; height: 26px; text-size: 11px; clicked => { root.pick-kind("aria2"); } }
                    AppButton { label: "Gopeed"; height: 26px; text-size: 11px; clicked => { root.pick-kind("gopeed"); } }
                    Text {
                        text: root.downloader-kind;
                        color: Theme.mauve;
                        font-size: 11px;
                        width: 96px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.downloader-status;
                        color: Theme.sub;
                        font-size: 11px;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: "地址，例 http://localhost:8080";
                        text <=> root.downloader-url;
                    }
                    LineEdit {
                        width: 96px;
                        placeholder-text: "用户名";
                        text <=> root.downloader-user;
                    }
                    LineEdit {
                        width: 110px;
                        placeholder-text: "密码 / token";
                        text <=> root.downloader-secret;
                    }
                    AppButton { label: "探测"; height: 26px; text-size: 11px; clicked => { root.detect-downloader(); } }
                    AppButton { label: "保存"; height: 26px; text-size: 11px; clicked => { root.save-downloader(); } }
                }

                HorizontalLayout {
                    spacing: 6px;
                    Text { text: "索引器"; color: Theme.sub; font-size: 11px; vertical-alignment: center; }
                    LineEdit {
                        width: 120px;
                        placeholder-text: "名字，例 Jackett";
                        text <=> root.indexer-name;
                    }
                    LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: "Torznab 地址，例 http://localhost:9117";
                        text <=> root.indexer-url;
                    }
                    LineEdit {
                        width: 130px;
                        placeholder-text: "API key";
                        text <=> root.indexer-key;
                    }
                    AppButton { label: "添加"; height: 26px; text-size: 11px; clicked => { root.add-indexer(); } }
                    AppButton { label: "清空"; height: 26px; text-size: 11px; clicked => { root.clear-indexers(); } }
                }

                HorizontalLayout {
                    spacing: 6px;
                    Text { text: "网盘"; color: Theme.sub; font-size: 11px; vertical-alignment: center; }
                    LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: "PanSou 地址，例 http://127.0.0.1:8888";
                        text <=> root.pansou-url;
                    }
                    LineEdit {
                        width: 130px;
                        placeholder-text: "Token（可空）";
                        text <=> root.pansou-token;
                    }
                    AppButton { label: "保存"; height: 26px; text-size: 11px; clicked => { root.save-pansou(); } }
                    AppButton { label: "探活"; height: 26px; text-size: 11px; clicked => { root.probe-pansou(); } }
                    Text { text: root.pansou-status; color: Theme.sub; font-size: 11px; vertical-alignment: center; }
                }

                // 数据源导入：TVBox 单仓 / LibreTV 源列表 / Prowlarr 清单 / 一行一个 URL，
                // 格式自动判断（判据见 source_import::guess_format）。网页贴进去也行 —— 会当纯文本猜。
                HorizontalLayout {
                    spacing: 6px;
                    Text { text: "导入源"; color: Theme.sub; font-size: 11px; vertical-alignment: center; }
                    LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: "TVBox / LibreTV / Prowlarr 地址，或一行一个 URL";
                        text <=> root.tvbox-url;
                    }
                    AppButton { label: "导入"; height: 26px; text-size: 11px; clicked => { root.import-tvbox(); } }
                    AppButton { label: "清空"; height: 26px; text-size: 11px; clicked => { root.clear-tvbox(); } }
                    Text { text: root.tvbox-status; color: Theme.sub; font-size: 11px; vertical-alignment: center; }
                }

                // 手写规则：把「加一个站」从改代码变成贴一段规则。
                // 语法见 docs/SOURCES-DESIGN.md §2（base / search / rows / fields）。
                HorizontalLayout {
                    spacing: 6px;
                    Text { text: "规则"; color: Theme.sub; font-size: 11px; vertical-alignment: top; }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        TextEdit {
                            height: 84px;
                            text <=> root.rule-text;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            AppButton { label: "测试"; height: 26px; text-size: 11px; clicked => { root.test-rule(); } }
                            AppButton { label: "保存"; height: 26px; text-size: 11px; clicked => { root.save-rule(); } }
                            Text {
                                text: root.rule-status;
                                color: Theme.sub;
                                font-size: 11px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }

                // 订阅：贴一个「返回源清单」的 URL，加完立刻拉一次。
                HorizontalLayout {
                    spacing: 6px;
                    Text { text: "订阅"; color: Theme.sub; font-size: 11px; vertical-alignment: center; }
                    LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: "源清单 URL（TVBox / LibreTV / Prowlarr 自动识别）";
                        text <=> root.sub-url;
                    }
                    AppButton { label: "添加"; height: 26px; text-size: 11px; clicked => { root.add-subscription(); } }
                    AppButton { label: "刷新"; height: 26px; text-size: 11px; clicked => { root.refresh-subs(); } }
                    Text { text: root.sub-status; color: Theme.sub; font-size: 11px; vertical-alignment: center; }
                }

                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: root.indexer-status;
                        color: Theme.sub;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    for ix in root.indexers : HorizontalLayout {
                        spacing: 4px;
                        Text {
                            text: ix.label;
                            color: Theme.sub;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        AppButton {
                            label: ix.action;
                            height: 26px;
                            text-size: 11px;
                            clicked => { root.toggle-indexer(ix.id); }
                        }
                    }
                }

                // ---- 数据源（sources.json）摘要 ----
                // 批次 1 只显示一句「内置 N · 导入 M · 订阅 K」；列表与开关在批次 2。
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "数据源";
                        color: Theme.sub;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.sources-status;
                        color: Theme.sub;
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }

                // ---- 站点开关（从右栏搬来：右栏让位给屏 01 的三张卡）----
                HorizontalLayout {
                    spacing: 6px;

                    Text {
                        text: "站点";
                        color: Theme.sub;
                        font-size: 11px;
                        vertical-alignment: top;
                    }

                    // 取消到零个时 Rust 侧**不发搜索**（不是"搜全部"）—— 见 ui_model 注释
                    ListView {
                        horizontal-stretch: 1;
                        height: 148px;
                        for s in root.sites : SiteRow {
                            item: s;
                            toggle(id) => { root.toggle-site(id); }
                        }
                    }
                }
            }
        }

        // ---- 主体：结果列表 + 右栏（屏 01：扫描 / 下载器 / 统计 + 逐站状态）----
        HorizontalLayout {
            vertical-stretch: 1;
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 14px;
            spacing: 16px;

            // 列表外壳：圆角 + 描边（行自己画分隔线）
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.mantle;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.surface0;

                // ⚠️ ListView 不是布局，直接挂在 Rectangle 下不会铺满 —— 套一层 VerticalLayout
                // ⚠️ 三个 ListView 必须用 `if` 互斥：都写 `visible:` 的话三者同时占位，
                // 每个只分到约 1/3 高度 ⇒ 502 条结果只画出 1 条（用户 2026-10-26 截图）。
                VerticalLayout {
                    if root.mode == 0 : ListView {
                        vertical-stretch: 1;
                        for row in root.rows : ResultCard {
                            item: row;
                            push(idx) => { root.push-row(idx); }
                            open(idx) => { root.open-row(idx); }
                            toggle(idx) => { root.toggle-row(idx); }
                        }
                    }

                    // Video 模式：独立的列表，不参与勾选/推送。
                    if root.mode == 1 : ListView {
                        vertical-stretch: 1;
                        for row in root.video-rows : VideoCard {
                            item: row;
                            open(idx) => { root.open-video(idx); }
                        }
                    }

                    // Pan 模式：独立的列表，点击打开网盘链接 + 复制提取码。
                    if root.mode == 2 : ListView {
                        vertical-stretch: 1;
                        for row in root.pan-rows : PanCard {
                            item: row;
                            open(idx) => { root.open-pan(idx); }
                        }
                    }

                    // ---- 屏 02 空态：海报式主视觉（巨型站点数水印 + 双行大标题）----
                    if root.mode == 0 && (root.rows.length == 0) : Rectangle {
                        vertical-stretch: 1;
                        background: transparent;

                        // 水印：绝对定位、不参与布局；先声明所以在标题下层
                        Text {
                            x: 28px;
                            y: 0px;
                            text: "\{root.providers.length}";
                            font-size: 132px;
                            font-weight: 700;
                            color: Theme.surface0;
                            opacity: 0.30;
                        }

                        VerticalLayout {
                            alignment: center;
                            padding: 44px;
                            spacing: 2px;

                            Text {
                                text: "一个关键词";
                                font-size: 40px;
                                font-weight: 300;
                                color: Theme.text;
                            }

                            Text {
                                text: "扫完 \{root.providers.length} 个站点。";
                                font-size: 40px;
                                font-weight: 700;
                                color: Theme.mauve;
                            }

                            Rectangle {
                                height: 10px;
                            }

                            Text {
                                text: "磁力聚合 · 跨站去重 · 直推 qBittorrent / Transmission / aria2 / Gopeed";
                                font-size: 12px;
                                color: Theme.sub;
                            }

                            Text {
                                text: "在搜索框输入关键词，回车开始";
                                font-size: 11px;
                                color: Theme.dim;
                            }
                        }
                    }

                    // ---- Video 模式空态 ----
                    if root.mode == 1 && (root.video-rows.length == 0) : Rectangle {
                        vertical-stretch: 1;
                        background: transparent;

                        Text {
                            x: 28px;
                            y: 0px;
                            text: "\{root.video-sites}";
                            font-size: 132px;
                            font-weight: 700;
                            color: Theme.surface0;
                            opacity: 0.30;
                        }

                        VerticalLayout {
                            alignment: center;
                            padding: 44px;
                            spacing: 2px;

                            Text {
                                text: "一个片名";
                                font-size: 40px;
                                font-weight: 300;
                                color: Theme.text;
                            }

                            Text {
                                text: "搜 \{root.video-sites} 家在线影视站。";
                                font-size: 40px;
                                font-weight: 700;
                                color: Theme.mauve;
                            }

                            Rectangle {
                                height: 10px;
                            }

                            Text {
                                text: "只做搜索与跳转 · 不内嵌播放 · 不缓存";
                                font-size: 12px;
                                color: Theme.sub;
                            }

                            Text {
                                text: "点结果右侧「打开网页」用系统浏览器打开";
                                font-size: 11px;
                                color: Theme.dim;
                            }
                        }
                    }

                    // ---- Pan 模式空态 ----
                    if root.mode == 2 && (root.pan-rows.length == 0) : Rectangle {
                        vertical-stretch: 1;
                        background: transparent;

                        Text {
                            x: 28px;
                            y: 0px;
                            text: "pan";
                            font-size: 132px;
                            font-weight: 700;
                            color: Theme.surface0;
                            opacity: 0.30;
                        }

                        VerticalLayout {
                            alignment: center;
                            padding: 44px;
                            spacing: 2px;

                            Text {
                                text: "一个关键词";
                                font-size: 40px;
                                font-weight: 300;
                                color: Theme.text;
                            }

                            Text {
                                text: "搜网盘。";
                                font-size: 40px;
                                font-weight: 700;
                                color: Theme.mauve;
                            }

                            Rectangle {
                                height: 10px;
                            }

                            Text {
                                text: "PanSou · 夸克 / 百度 / 阿里 / UC / 115 / PikPak…";
                                font-size: 12px;
                                color: Theme.sub;
                            }

                            Text {
                                text: "先在设置里填 PanSou 地址（默认 127.0.0.1:8888）";
                                font-size: 11px;
                                color: Theme.dim;
                            }
                        }
                    }
                }

                // ---- 批量操作条（屏 01：列表内**浮层**，绝对定位）----
                // ⚠️ 原来它是 VerticalLayout 里的一行，勾选时把列表挤短 44px；
                // 设计稿是浮层，不参与布局。父是列表外壳 Rectangle（不是布局），
                // 所以 x/y 生效；外壳没有 `clip`，浮层不会被圆角裁掉。
                if root.selected-count > 0 : Rectangle {
                    x: (parent.width - 460px) / 2;
                    y: parent.height - 60px;
                    width: 460px;
                    height: 44px;
                    background: Theme.surface0;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.dim;
                    drop-shadow-color: #00000055;
                    drop-shadow-blur: 12px;
                    drop-shadow-offset-y: 4px;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 6px;

                        Text {
                            text: "已选 \{root.selected-count} 项";
                            font-size: 11px;
                            font-weight: 600;
                            color: Theme.text;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        AppButton {
                            label: "全选";
                            height: 28px;
                            text-size: 11px;
                            clicked => { root.select-all(); }
                        }

                        AppButton {
                            label: "批量推送";
                            height: 28px;
                            text-size: 11px;
                            primary: true;
                            clicked => { root.batch-push(); }
                        }

                        AppButton {
                            label: "导出 CSV";
                            height: 28px;
                            text-size: 11px;
                            clicked => { root.export-csv(); }
                        }

                        AppButton {
                            label: "复制磁力";
                            height: 28px;
                            text-size: 11px;
                            clicked => { root.copy-selected-magnets(); }
                        }

                        AppButton {
                            label: "取消";
                            height: 28px;
                            text-size: 11px;
                            clicked => { root.clear-selection(); }
                        }
                    }
                }
            }

            // ⚠️ 右栏与详情面板必须 `if` 互斥：详情面板 width 460px，用 `visible:` 关闭时
            // 会白占 460px 宽，把列表压到最小宽度（21..498，右侧 466px 全空）。
            if !root.detail-open && root.mode == 0 : Rectangle {
                width: 300px;
                background: Theme.mantle;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.surface0;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    // ---- 卡 1：引擎扫描（屏 01 右栏第一张）----
                    Rectangle {
                        background: Theme.base;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.surface0;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 6px;

                            HorizontalLayout {
                                spacing: 6px;

                                Text {
                                    text: "引擎扫描";
                                    font-size: 9px;
                                    color: Theme.dim;
                                    vertical-alignment: bottom;
                                    horizontal-stretch: 1;
                                }

                                Text {
                                    text: "\{root.scan-done}/\{root.scan-total}";
                                    font-size: 17px;
                                    font-weight: 700;
                                    color: Theme.text;
                                    vertical-alignment: bottom;
                                }
                            }

                            // 进度条：外层画底，内层按 scan-progress 占宽
                            Rectangle {
                                height: 4px;
                                border-radius: 2px;
                                background: Theme.surface0;

                                Rectangle {
                                    x: 0;
                                    width: parent.width * root.scan-progress;
                                    height: 4px;
                                    border-radius: 2px;
                                    background: Theme.green;
                                }
                            }

                            Text {
                                text: root.scan-note;
                                font-size: 9px;
                                color: Theme.dim;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // ---- 卡 2：下载器 ----
                    Rectangle {
                        background: Theme.base;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.surface0;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 3px;

                            Text {
                                text: "下载器";
                                font-size: 9px;
                                color: Theme.dim;
                            }

                            Text {
                                text: root.downloader-name;
                                font-size: 13px;
                                font-weight: 600;
                                color: Theme.mauve;
                            }

                            Text {
                                text: root.downloader-status;
                                font-size: 9px;
                                color: Theme.sub;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // ---- 卡 3：本次统计（2×2）----
                    Rectangle {
                        background: Theme.base;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: Theme.surface0;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 6px;

                            Text {
                                text: "本次统计";
                                font-size: 9px;
                                color: Theme.dim;
                            }

                            HorizontalLayout {
                                spacing: 8px;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 1px;
                                    Text {
                                        text: "\{root.stats-hits}";
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: Theme.text;
                                    }
                                    Text { text: "命中"; font-size: 9px; color: Theme.dim; }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 1px;
                                    Text {
                                        text: "\{root.stats-dedup}";
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: Theme.text;
                                    }
                                    Text { text: "去重"; font-size: 9px; color: Theme.dim; }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 1px;
                                    Text {
                                        text: "\{root.stats-fail}";
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: root.stats-fail > 0 ? Theme.err : Theme.text;
                                    }
                                    Text { text: "失败"; font-size: 9px; color: Theme.dim; }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 1px;
                                    Text {
                                        text: root.stats-elapsed;
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: Theme.text;
                                    }
                                    Text { text: "耗时"; font-size: 9px; color: Theme.dim; }
                                }
                            }
                        }
                    }

                    // ---- 引擎明细（逐站状态；站点开关已移到「设置」里）----
                    RailLabel { text: "逐站状态"; }

                    ListView {
                        vertical-stretch: 1;
                        for p in root.providers : ProviderRow { item: p; }
                    }
                }
            }

            // ---- 屏 03 详情面板：占右栏位置（同一时刻只显示一个）----
            if root.detail-open : Rectangle {
                width: 460px;
                background: Theme.mantle;
                border-radius: 12px;
                border-width: 1px;
                border-color: Theme.surface0;

                VerticalLayout {
                    padding: 20px;
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 8px;

                        Text {
                            text: "详情";
                            font-size: 10px;
                            color: Theme.dim;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        AppButton {
                            label: "关闭";
                            width: 64px;
                            height: 26px;
                            text-size: 11px;
                            clicked => { root.close-detail(); }
                        }
                    }

                    Text {
                        text: root.detail-title;
                        font-size: 17px;
                        font-weight: 600;
                        color: Theme.text;
                    }

                    Text {
                        text: root.detail-meta;
                        font-size: 11px;
                        color: Theme.sub;
                    }

                    HorizontalLayout {
                        spacing: 16px;

                        Text {
                            text: "做种 \{root.detail-seeds}";
                            font-size: 11px;
                            color: Theme.green;
                            vertical-alignment: center;
                        }

                        Text {
                            text: "下载 \{root.detail-leechers}";
                            font-size: 11px;
                            color: Theme.text;
                            vertical-alignment: center;
                        }

                        Text {
                            text: "来源 \{root.detail-provider}";
                            font-size: 11px;
                            color: Theme.accent;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "INFOHASH";
                        font-size: 10px;
                        color: Theme.dim;
                    }

                    Text {
                        text: root.detail-infohash;
                        font-size: 10px;
                        color: Theme.text;
                    }

                    Text {
                        text: "磁力";
                        font-size: 10px;
                        color: Theme.dim;
                    }

                    Text {
                        text: root.detail-magnet;
                        font-size: 10px;
                        color: Theme.sub;
                    }

                    // 把按钮推到底部
                    Rectangle {
                        vertical-stretch: 1;
                    }

                    // 找字幕：只拼各家搜索页交给浏览器（不内置抓取）。
                    // 三个按钮的 id 是 `bt_providers::subs::SubtitleSite.id`，Rust 侧按 id 查表。
                    Text {
                        text: "找字幕";
                        font-size: 10px;
                        color: Theme.dim;
                    }

                    HorizontalLayout {
                        spacing: 6px;

                        AppButton {
                            label: "SubHD";
                            height: 30px;
                            text-size: 11px;
                            clicked => { root.find-subtitle(root.detail-idx, "subhd"); }
                        }

                        AppButton {
                            label: "ASSRT";
                            height: 30px;
                            text-size: 11px;
                            clicked => { root.find-subtitle(root.detail-idx, "assrt"); }
                        }

                        AppButton {
                            label: "字幕库";
                            height: 30px;
                            text-size: 11px;
                            clicked => { root.find-subtitle(root.detail-idx, "zimuku"); }
                        }

                        // 吃掉剩余宽度，避免三个按钮被布局拉宽
                        Rectangle {
                            horizontal-stretch: 1;
                        }
                    }

                    AppButton {
                        label: "复制磁力";
                        height: 34px;
                        text-size: 12px;
                        clicked => { root.copy-magnet(root.detail-idx); }
                    }

                    AppButton {
                        label: root.detail-action;
                        height: 40px;
                        primary: true;
                        clicked => { root.push-row(root.detail-idx); }
                    }
                }
            }
        }

        // ---- 状态栏 ----
        Rectangle {
            height: 28px;
            background: Theme.mantle;

            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 10px;

                Text {
                    text: root.mode == 1 ? "共 \{root.total} 条 · 在线影视" : (root.mode == 2 ? "共 \{root.total} 条 · 网盘" : "共 \{root.total} 条 · 第 \{root.page} 页");
                    color: Theme.dim;
                    font-size: 10px;
                    vertical-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;
                }
            }
        }
    }
}
