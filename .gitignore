# 依赖（已在项目内安装，不入库）
node_modules/

# 环境变量 / 本地配置（忽略所有 .env 变体，但保留示例模板）
.env
.env.*
!.env.example
*.local

# 密钥 / 证书（防止误提交导致泄露）
*.pem
*.key
*.crt
*.cer
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*

# 日志
*.log
npm-debug.log*

# 系统 / 编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/

# 构建缓存（重定向到项目目录，避免占用 C 盘）
.cache/

# agent / 本地工具数据（非项目文件，不入库）
# .workbuddy/ 是本项目的记忆库，其余是各 agent 工具的本地状态
.workbuddy/
# 同类：WorkBuddy 的工作区记忆（memory/ 日志与长期笔记），同样是本地状态
.workbuddy-ai/
.dsh-meow/
.dsh-vision-toolkit/
.agents/
.claude/
.reasonix/
.nezha/
skills-lock.json

# Torznab 索引器配置（含 API Key，本地数据，禁止入库）
data/

# 打包产物（portable 版约 360MB，不入库）
dist/

# Tauri（Rust 构建产物 + 生成的 sidecar 二进制与生成文件）
src-tauri/target/
src-tauri/binaries/
src-tauri/gen/

# Rust workspace（feat/rust 主线）构建产物 —— 本机不开构建，target 只会在 CI 产生
/target/


# 本地审计报告（本轮 4 份 .md，不入库）
.audit/
__pycache__/
